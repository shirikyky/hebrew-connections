[Unit]
Description=חיבורים backend (Hebrew Connections API)
After=network.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/home/hermes/hebrew-connections
Environment=PORT=8787
Environment=HOST=127.0.0.1
ExecStart=/home/hermes/.local/bin/node server/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
